@model About    

<section id="about" class="bg-white border-top border-bottom">
      <div class="container">
        <div class="row align-items-center gy-5">
          <!-- Left Column: Portrait and visual composition -->
          <div class="col-lg-5 reveal-on-scroll">
            <div class="about-img-wrap">
              <img src="@Url.Content(Model.ImageUrl)" alt="@Model.FullName portre" class="w-100" style="height: 540px; object-fit: cover; object-position: center top;">
              <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                <span class="small text-muted font-heading">@Model.FullName, @Model.Location</span>
                <span class="badge bg-secondary-subtle text-dark fw-medium">@Model.Profession</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Story & Stats -->
          <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
            <div class="eyebrow-badge">
              <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
            </div>
            <h2 class="section-title">
              @Model.Title
            </h2>
            <div class="text-muted fs-5 mb-4 lh-base">
              <p class="mb-3">
               @Model.Description
              </p>
            </div>

            <!-- Statistics -->
            <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
              <div class="col-4">
                        <div class="stat-number">@Model.StatisticValue1</div>
                        <div class="stat-label">@Model.StatisticTitle1</div>
              </div>
              <div class="col-4">
                <div class="stat-number">@Model.StatisticValue2</div>
                <div class="stat-label">@Model.StatisticTitle2</div>
              </div>
              <div class="col-4">
                <div class="stat-number">@Model.StatisticValue3</div>
                <div class="stat-label">@Model.StatisticTitle3</div>
              </div>
            </div>

            <div class="d-flex align-items-center gap-3">
              <a href="#" class="btn-sage" onclick="alert('Özgeçmiş PDF dosyası hazırlandı.'); return false;">
                <i class="bi bi-file-earmark-pdf"></i>
                <span>Özgeçmişimi İncele</span>
              </a>
              <a href="#contact" class="btn-secondary-custom">
                <span>Bana Ulaşın</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
