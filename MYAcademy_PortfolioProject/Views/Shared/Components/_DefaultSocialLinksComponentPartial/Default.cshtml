@model List<SocialMedia>

<div class="pt-2">
                            <div class="text-muted small font-heading fw-semibold mb-2">Sosyal Ağlar:</div>
                            <div class="d-flex gap-2">
                                @foreach (var socialLink in Model)
                                {
                                    <a href="@socialLink.Url" target="_blank" rel="noopener noreferrer" class="social-pill" title="@socialLink.PlatformName">
                                        <i class="@socialLink.IconUrl"></i>
                                    </a>
                                }
                            </div>
                        </div>