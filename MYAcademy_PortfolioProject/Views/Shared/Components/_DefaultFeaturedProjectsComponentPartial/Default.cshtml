
@model List<Project>

<section id="projects">
    <div class="container">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>

                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>

                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <!-- Dinamik Kategori Filtreleri -->
            <div class="d-flex flex-wrap gap-2" id="projectFilters">

                <button class="filter-btn active" data-filter="all">
                    Tümü
                </button>

                @foreach (var category in Model
                    .Where(x => x.Category != null)
                    .Select(x => x.Category)
                    .DistinctBy(x => x.CategoryId))
                {
                    <button class="filter-btn"
                            data-filter="@category.CategoryId">
                        @category.CategoryName
                    </button>
                }

            </div>
        </div>

        <!-- Proje Kartları -->
        <div class="row g-4" id="projectGrid">

            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];

                <div class="col-lg-6 project-item reveal-on-scroll"
                     data-category="@item.CategoryId">

                    <div class="project-card">

                        <div class="project-thumb-wrap">

                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.ProjectTitle"
                                     class="project-thumb-img">
                            }
                            else
                            {
                                <div class="project-image-placeholder">
                                    <i class="bi bi-image"></i>
                                </div>
                            }

                            <span class="project-category-tag">
                                @item.Category?.CategoryName
                            </span>

                        </div>

                        <div class="project-body">

                            <h3 class="h4 fw-bold mb-2">
                                @(i + 1). @item.ProjectTitle
                            </h3>

                            <p class="text-muted small mb-4 flex-grow-1">
                                @item.Description
                            </p>

                            <!-- Dinamik Teknolojiler -->
                            <div class="mb-4">

                                @foreach (var technology in item.ProjectTechnologies ?? new List<ProjectTechnology>())
                                {
                                    <span class="tech-badge">
                                        @technology.TechnologyName
                                    </span>
                                }

                            </div>

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top">

                                <a href="@item.GithubUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="btn-sage btn-sm">

                                    <span>Projeyi İncele</span>
                                    <i class="bi bi-arrow-up-right"></i>

                                </a>

                                <span class="text-muted small">
                                    <i class="bi bi-github me-1"></i>
                                    GitHub
                                </span>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="text-center mt-5">
            <a href="https://github.com/yavuzsevimdev/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn-secondary-custom px-4 py-3">

                <span>Tüm Projelerimi Gör</span>
                <i class="bi bi-arrow-right"></i>

            </a>
        </div>

    </div>
</section>
