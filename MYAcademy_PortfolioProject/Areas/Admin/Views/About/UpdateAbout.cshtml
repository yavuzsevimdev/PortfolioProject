
@model About

@{
    ViewData["Title"] = "Hakkımda Bilgilerini Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <!-- Sayfa Başlığı -->
    <div class="content-header-row mb-4">
        <div>
            <h4 class="page-title">Hakkımda Bilgilerini Güncelle</h4>
            <p class="page-subtitle">
                Profil bilgilerinizi, açıklamanızı ve istatistiklerinizi düzenleyin.
            </p>
        </div>

        <a href="/Admin/About/Index"
           class="btn-table-util text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>
            Listeye Dön
        </a>
    </div>

    <div class="data-table-card">

        <form method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="AboutId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <!-- Kişisel Bilgiler -->
            <div class="mb-4">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-person me-2"></i>
                    Kişisel Bilgiler
                </h6>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">
                            Ad Soyad
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Adınızı ve soyadınızı giriniz." />

                        <span asp-validation-for="FullName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Profession" class="form-label">
                            Meslek
                        </label>

                        <input asp-for="Profession"
                               class="form-control"
                               placeholder="Örn: .NET Developer" />

                        <span asp-validation-for="Profession"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label">
                            Konum
                        </label>

                        <input asp-for="Location"
                               class="form-control"
                               placeholder="Örn: İstanbul, Türkiye" />

                        <span asp-validation-for="Location"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">
                            Başlık
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Profil başlığınızı giriniz." />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>

            <hr class="my-4" />

            <!-- Profil İçeriği -->
            <div class="mb-4">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-file-text me-2"></i>
                    Profil İçeriği
                </h6>

                <div class="row g-4">

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">
                            Açıklama
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Kendiniz hakkında açıklama giriniz."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label">
                            Profil Görseli URL
                        </label>

                        <input asp-for="ImageUrl"
                               class="form-control"
                               placeholder="Profil görseli bağlantısını giriniz." />

                        <span asp-validation-for="ImageUrl"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CvUrl" class="form-label">
                            CV URL
                        </label>

                        <input asp-for="CvUrl"
                               class="form-control"
                               placeholder="CV bağlantısını giriniz." />

                        <span asp-validation-for="CvUrl"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>

            <hr class="my-4" />

            <!-- İstatistik Bilgileri -->
            <div class="mb-4">
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-bar-chart me-2"></i>
                    İstatistik Bilgileri
                </h6>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="StatisticValue1" class="form-label">
                            1. İstatistik Değeri
                        </label>

                        <input asp-for="StatisticValue1"
                               class="form-control"
                               placeholder="Örn: 5+" />

                        <span asp-validation-for="StatisticValue1"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StatisticTitle1" class="form-label">
                            1. İstatistik Başlığı
                        </label>

                        <input asp-for="StatisticTitle1"
                               class="form-control"
                               placeholder="Örn: Yıllık Deneyim" />

                        <span asp-validation-for="StatisticTitle1"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StatisticValue2" class="form-label">
                            2. İstatistik Değeri
                        </label>

                        <input asp-for="StatisticValue2"
                               class="form-control"
                               placeholder="Örn: 20+" />

                        <span asp-validation-for="StatisticValue2"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StatisticTitle2" class="form-label">
                            2. İstatistik Başlığı
                        </label>

                        <input asp-for="StatisticTitle2"
                               class="form-control"
                               placeholder="Örn: Tamamlanan Proje" />

                        <span asp-validation-for="StatisticTitle2"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StatisticValue3" class="form-label">
                            3. İstatistik Değeri
                        </label>

                        <input asp-for="StatisticValue3"
                               class="form-control"
                               placeholder="Örn: 10+" />

                        <span asp-validation-for="StatisticValue3"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StatisticTitle3" class="form-label">
                            3. İstatistik Başlığı
                        </label>

                        <input asp-for="StatisticTitle3"
                               class="form-control"
                               placeholder="Örn: Kullanılan Teknoloji" />

                        <span asp-validation-for="StatisticTitle3"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>

            <hr class="my-4" />

            <!-- Form Butonları -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <a href="/Admin/About/AboutList"
                   class="btn-table-util text-decoration-none">
                    <i class="bi bi-x-lg me-1"></i>
                    İptal
                </a>

                <button type="submit" class="btn-pastel-primary">
                    <i class="bi bi-check-lg me-1"></i>
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>
    </div>
</div>
