
@model About

@{
    ViewData["Title"] = "Hakkımda Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="content-header-row">
    <div>
        <h2 class="page-title">Hakkımda Bilgileri</h2>
        <p class="page-subtitle">
            Kişisel profil bilgilerinizi buradan yönetebilirsiniz.
        </p>
    </div>

    <a href="/Admin/About/CreateAbout" class="btn-pastel-primary">
        <i class="bi bi-plus-lg"></i>
        Yeni Hakkımda Bilgisi
    </a>
</div>

<div class="data-table-card">
    <div class="table-responsive">
        <table class="table custom-admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Görsel</th>
                    <th>Ad Soyad</th>
                    <th>Meslek</th>
                    <th>Konum</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null)
                {
                    <tr>
                        <td>@Model.AboutId</td>

                        <td>
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Url.Content(Model.ImageUrl)"
                                     alt="@Model.FullName"
                                     style="width:55px; height:55px; object-fit:cover; border-radius:10px;" />
                            }
                            else
                            {
                                <span class="text-muted">Görsel yok</span>
                            }
                        </td>

                        <td>
                            <strong>@Model.FullName</strong>
                        </td>

                        <td>@Model.Profession</td>

                        <td>
                            <i class="bi bi-geo-alt me-1"></i>
                            @Model.Location
                        </td>

                        <td class="text-center">
                            <a href="/Admin/About/UpdateAbout/@Model.AboutId"
                               class="btn-action-icon btn-edit"
                               title="Düzenle">
                                <i class="bi bi-pencil-square"></i>
                            </a>

                            <form action="/Admin/About/DeleteAbout/@Model.AboutId"
                                  method="post"
                                  class="delete-form d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn-action-icon btn-delete"
                                        title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            Henüz hakkımda bilgisi eklenmemiş.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
