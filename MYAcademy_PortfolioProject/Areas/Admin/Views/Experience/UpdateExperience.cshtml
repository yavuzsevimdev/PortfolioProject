
@model Experience

@{
    ViewData["Title"] = "Deneyim Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <div class="content-header-row">
        <div>
            <h2 class="page-title">Deneyim Düzenle</h2>
            <p class="page-subtitle">
                Mevcut deneyim bilgilerinizi buradan güncelleyebilirsiniz.
            </p>
        </div>

        <a href="/Admin/Experience/ExperienceList" class="btn-table-util">
            <i class="bi bi-arrow-left me-2"></i>
            Geri Dön
        </a>
    </div>

    <div class="data-table-card">

        <div class="mb-4">
            <h5 class="fw-semibold mb-1">Deneyim Bilgileri</h5>
            <small class="text-muted">
                Güncellemek istediğiniz alanları düzenleyiniz.
            </small>
        </div>

        <form method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="ExperienceId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Title" class="form-label">Deneyim Başlığı</label>
                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Deneyim başlığı" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyName" class="form-label">Kurum / Şirket</label>
                    <input asp-for="CompanyName"
                           class="form-control"
                           placeholder="Kurum / şirket adı" />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CategoryName" class="form-label">Çalışma Türü / Kategori</label>
                    <input asp-for="CategoryName"
                           class="form-control"
                           placeholder="Çalışma türü" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label d-block">Yayın Durumu</label>

                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox"
                               role="switch" />
                        <label asp-for="IsActive" class="form-check-label">
                            Aktif olarak yayınla
                        </label>
                    </div>
                </div>

                <div class="col-12 mb-3">
                    <label asp-for="Description" class="form-label">Deneyim Açıklaması</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Deneyim açıklaması"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">

                <a href="/Admin/Experience/ExperienceList" class="btn-table-util">
                    İptal
                </a>

                <button type="submit" class="btn-pastel-primary">
                    <i class="bi bi-check-lg me-2"></i>
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>

    </div>
</div>
