@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    // İstatistik kartları - Statik veriler
    var stats = new[]
    {
        (Val: Model.TotalProjectCount, Lbl: "Toplam Proje", Icon: "bi-folder", Cls: "c-green"),
        (Val: Model.ActiveProjectCount, Lbl: "Aktif Proje", Icon: "bi-folder-check", Cls: "c-blue"),
        (Val: Model.SkillCount, Lbl: "Yetenek", Icon: "bi-lightning", Cls: "c-purple"),
        (Val: Model.ExperienceCount, Lbl: "Deneyim", Icon: "bi-briefcase", Cls: "c-orange"),
        (Val: Model.EducationCount, Lbl: "Eğitim", Icon: "bi-mortarboard", Cls: "c-blue"),
        (Val: Model.TotalMessageCount, Lbl: "Toplam Mesaj", Icon: "bi-envelope", Cls: "c-green"),
        (Val: Model.TotalUnreadMessageCount, Lbl: "Okunmamış Mesaj", Icon: "bi-envelope-exclamation", Cls: "c-rose")
    };

    // Son 5 mesaj - Statik veriler
    var messages = new[]
    {
        (Id: Model.LastFiveMessages[0].MessageId, Name: Model.LastFiveMessages[0].SenderName, Subject: Model.LastFiveMessages[0].Subject, Date: Model.LastFiveMessages[0].SendDate.ToString("dd MMMM yyyy, HH:mm"), IsRead: Model.LastFiveMessages[0].IsRead),
        (Id: Model.LastFiveMessages[1].MessageId, Name: Model.LastFiveMessages[1].SenderName, Subject: Model.LastFiveMessages[1].Subject, Date: Model.LastFiveMessages[1].SendDate.ToString("dd MMMM yyyy, HH:mm"), IsRead: Model.LastFiveMessages[1].IsRead),
        (Id: Model.LastFiveMessages[2].MessageId, Name: Model.LastFiveMessages[2].SenderName, Subject: Model.LastFiveMessages[2].Subject, Date: Model.LastFiveMessages[2].SendDate.ToString("dd MMMM yyyy, HH:mm"), IsRead: Model.LastFiveMessages[2].IsRead),
        (Id: Model.LastFiveMessages[3].MessageId, Name: Model.LastFiveMessages[3].SenderName, Subject: Model.LastFiveMessages[3].Subject, Date: Model.LastFiveMessages[3].SendDate.ToString("dd MMMM yyyy, HH:mm"), IsRead: Model.LastFiveMessages[3].IsRead),
        (Id: Model.LastFiveMessages[4].MessageId, Name: Model.LastFiveMessages[4].SenderName, Subject: Model.LastFiveMessages[4].Subject, Date: Model.LastFiveMessages[4].SendDate.ToString("dd MMMM yyyy, HH:mm"), IsRead: Model.LastFiveMessages[4].IsRead)
    };

    // Son eklenen 3 proje - Statik veriler
    var projects = new[]
    {
        (Name: Model.LastThreeProjects[0].ProjectTitle, Category: Model.LastThreeProjects[0].Category.CategoryName, Date: Model.LastThreeProjects[0].CreatedDate.ToString("dd MMMM yyyy"), IsActive: Model.LastThreeProjects[0].IsActive),
        (Name: Model.LastThreeProjects[1].ProjectTitle, Category: Model.LastThreeProjects[1].Category.CategoryName, Date: Model.LastThreeProjects[1].CreatedDate.ToString("dd MMMM yyyy"), IsActive: Model.LastThreeProjects[1].IsActive),
        (Name: Model.LastThreeProjects[2].ProjectTitle, Category: Model.LastThreeProjects[2].Category.CategoryName, Date: Model.LastThreeProjects[2].CreatedDate.ToString("dd MMMM yyyy"), IsActive: Model.LastThreeProjects[2].IsActive)
    };
}

<style>
    .db {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
        --muted: #8a8a85;
    }

    .db-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem;
        height: 100%;
    }

    .db-title {
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .db-title small {
        color: var(--muted);
        font-weight: 400;
    }

    /* İstatistik Kartları */
    .stat {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-lbl {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .4rem;
    }

    .c-green {
        background: #e7efe9;
        color: #2f5d4e;
    }

    .c-blue {
        background: #e6eef8;
        color: #3b6ea5;
    }

    .c-rose {
        background: #f9e7e7;
        color: #b44b4b;
    }

    .c-purple {
        background: #eee9f8;
        color: #7956a5;
    }

    .c-orange {
        background: #fff0df;
        color: #c27b35;
    }

    /* Genel Liste Yapısı */
    .db-list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .9rem 0;
        border-bottom: 1px solid var(--line);
    }

    .db-list-item:last-child {
        border-bottom: none;
    }

    /* Mesajlar */
    .msg-row {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .85rem 0;
        border-bottom: 1px solid var(--line);
    }

    .msg-row:last-child {
        border-bottom: none;
    }

    .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .msg-body {
        flex: 1;
        min-width: 0;
    }

    .msg-body p {
        margin: .2rem 0 0;
        color: var(--muted);
        font-size: .85rem;
    }

    .badge-soft {
        font-size: .72rem;
        padding: .35rem .65rem;
        border-radius: 20px;
        white-space: nowrap;
    }

    /* Kategori */
    .category-count {
        font-size: .85rem;
        font-weight: 600;
        color: var(--g);
        background: var(--g-soft);
        padding: .35rem .7rem;
        border-radius: 20px;
    }

    /* Projeler */
    .project-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: #e6eef8;
        color: #3b6ea5;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    /* Hızlı Erişim */
    .quick-link {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .9rem 1rem;
        border: 1px solid var(--line);
        border-radius: 12px;
        color: #444;
        text-decoration: none;
        font-weight: 500;
        transition: all .2s ease;
    }

    .quick-link:hover {
        background: var(--g-soft);
        border-color: #d5e3d9;
        color: var(--g);
        transform: translateY(-2px);
    }

    .quick-link i {
        font-size: 1.15rem;
        color: var(--g);
    }

    .quick-link-arrow {
        margin-left: auto;
        color: var(--muted);
    }

    @@media (max-width: 576px) {
        .db-card {
            padding: 1rem;
        }

        .stat-val {
            font-size: 1.5rem;
        }

        .msg-row {
            flex-wrap: wrap;
        }
    }
</style>

<div class="db container-fluid py-3">

    <!-- İstatistik Kartları -->
    <div class="row g-3 mb-4">

        @foreach (var item in stats)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="db-card stat">

                    <div class="stat-icon @item.Cls">
                        <i class="bi @item.Icon"></i>
                    </div>

                    <div>
                        <div class="stat-val">@item.Val</div>
                        <div class="stat-lbl">@item.Lbl</div>
                    </div>

                </div>

            </div>
        }

    </div>

    <!-- Son Mesajlar ve Kategori Özeti -->
    <div class="row g-4 mb-4">

        <!-- Son 5 Mesaj -->
        <div class="col-xl-7">

            <div class="db-card">

                <div class="db-title">

                    <div>
                        <h5 class="mb-1 fw-semibold">Son 5 Mesaj</h5>
                        <small>Son gönderilen iletişim mesajları</small>
                    </div>

                    <a href="/Admin/Message/MessageList"
                       class="small text-decoration-none"
                       style="color:var(--g)">
                        Tümünü Gör
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

                @foreach (var message in messages)
                {
                    <div class="msg-row">

                        <div class="avatar">
                            @message.Name.Substring(0, 1)
                        </div>

                        <div class="msg-body">

                            <div class="fw-semibold">
                                @message.Name
                            </div>

                            <p>@message.Subject</p>

                            <small class="text-muted">
                                @message.Date
                            </small>

                        </div>

                        @if (message.IsRead)
                        {
                            <span class="badge-soft c-blue">
                                Okundu
                            </span>
                        }
                        else
                        {
                            <span class="badge-soft c-rose">
                                Okunmadı
                            </span>
                        }

                    </div>
                }

            </div>

        </div>

        <!-- Kategori Özeti -->
        <div class="col-xl-5">

            <div class="db-card">

                <div class="db-title">

                    <div>
                        <h5 class="mb-1 fw-semibold">Kategori Özeti</h5>
                        <small>Kategorilere göre proje dağılımı</small>
                    </div>

                    <i class="bi bi-tags fs-4" style="color:var(--g)"></i>

                </div>

                @foreach (var category in Model.Categories)
                {
                    <div class="db-list-item">

                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-folder2 text-muted"></i>
                            <span class="fw-medium">@category.CategoryName</span>
                        </div>

                        <span class="category-count">
                            @category.Projects.Count() Proje
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- Son Eklenen Projeler -->
    
<!-- Son Eklenen Projeler ve Hızlı Erişim -->
<div class="row g-4 mb-4">

    <!-- Son Eklenen Projeler -->
    <div class="col-xl-8">

        <div class="db-card">

            <div class="db-title">

                <div>
                    <h5 class="mb-1 fw-semibold">Son Eklenen Projeler</h5>
                    <small>Portfolyoya eklenen son 3 proje</small>
                </div>

                <a href="/Admin/Project/ProjectList"
                   class="small text-decoration-none"
                   style="color:var(--g)">
                    Tümünü Gör
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-sm align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Proje</th>
                            <th>Kategori</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var project in projects)
                        {
                            <tr>

                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <div class="project-icon">
                                            <i class="bi bi-folder2-open"></i>
                                        </div>

                                        <span class="fw-semibold small">
                                            @project.Name
                                        </span>

                                    </div>
                                </td>

                                <td>
                                    <small class="text-muted">
                                        @project.Category
                                    </small>
                                </td>

                                <td>
                                    @if (project.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- Hızlı Erişim -->
    <div class="col-xl-4">

        <div class="db-card">

            <div class="db-title">

                <div>
                    <h5 class="mb-1 fw-semibold">Hızlı Erişim</h5>
                    <small>Yönetim kısayolları</small>
                </div>

                <i class="bi bi-lightning-charge fs-4"
                   style="color:var(--g)"></i>

            </div>

            <div class="d-flex flex-column gap-2">

                <a href="/Admin/Project/CreateProject" class="quick-link">
                    <i class="bi bi-plus-circle"></i>
                    <span>Yeni Proje Ekle</span>
                    <i class="bi bi-arrow-up-right quick-link-arrow"></i>
                </a>

                <a href="/Admin/Message/MessageList" class="quick-link">
                    <i class="bi bi-envelope"></i>
                    <span>Mesajları Gör</span>
                    <i class="bi bi-arrow-up-right quick-link-arrow"></i>
                </a>

                <a href="/Admin/Skill/SkillList" class="quick-link">
                    <i class="bi bi-lightning"></i>
                    <span>Yetenekleri Yönet</span>
                    <i class="bi bi-arrow-up-right quick-link-arrow"></i>
                </a>

                <a href="/Admin/Category/Index" class="quick-link">
                    <i class="bi bi-tags"></i>
                    <span>Kategorileri Yönet</span>
                    <i class="bi bi-arrow-up-right quick-link-arrow"></i>
                </a>

            </div>

        </div>

    </div>


    </div>

</div>



