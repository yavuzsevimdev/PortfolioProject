
@model SocialMedia

@{
    ViewData["Title"] = "Sosyal Medya Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <div class="content-header-row">
        <div>
            <h2 class="page-title">Sosyal Medya Güncelle</h2>
            <p class="page-subtitle">
                Mevcut sosyal medya hesabının bilgilerini düzenleyebilirsiniz.
            </p>
        </div>

        <a href="/Admin/SocialMedia/SocialMediaList" class="btn-table-util">
            <i class="bi bi-arrow-left me-2"></i>
            Geri Dön
        </a>
    </div>

    <div class="data-table-card">

        <div class="mb-4">
            <h5 class="fw-semibold mb-1">Sosyal Medya Bilgileri</h5>
            <small class="text-muted">
                Güncellemek istediğiniz bilgileri düzenleyiniz.
            </small>
        </div>

        <form method="post" action="/Admin/SocialMedia/UpdateSocialMedia">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="SocialMediaId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PlatformName" class="form-label">Platform Adı</label>
                <input asp-for="PlatformName"
                       class="form-control"
                       placeholder="Örn: LinkedIn" />
                <span asp-validation-for="PlatformName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IconUrl" class="form-label">İkon Sınıfı</label>
                <input asp-for="IconUrl"
                       id="iconUrl"
                       class="form-control"
                       placeholder="Örn: bi bi-linkedin" />

                <span asp-validation-for="IconUrl" class="text-danger"></span>

                <small class="text-muted">
                    Bootstrap Icons sınıfını giriniz.
                </small>

                <div class="mt-3 d-flex align-items-center">
                    <span class="text-muted me-3">İkon Önizleme:</span>

                    <div class="d-flex align-items-center justify-content-center rounded-3"
                         style="width: 48px; height: 48px; background: #f3f0ff;">
                        <i id="iconPreview"
                           class="@(!string.IsNullOrWhiteSpace(Model.IconUrl) ? Model.IconUrl : "bi bi-question-circle")"
                           style="font-size: 26px; color: #7866c6;"></i>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Url" class="form-label">Profil Bağlantısı</label>
                <input asp-for="Url"
                       type="url"
                       class="form-control"
                       placeholder="https://..." />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">

                <a href="/Admin/SocialMedia/SocialMediaList" class="btn-table-util">
                    İptal
                </a>

                <button type="submit" class="btn-pastel-primary">
                    <i class="bi bi-check-lg me-2"></i>
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const iconInput = document.getElementById("iconUrl");
        const iconPreview = document.getElementById("iconPreview");

        iconInput.addEventListener("input", function () {

            const iconClass = this.value.trim();

            iconPreview.className = iconClass || "bi bi-question-circle";

        });

    });
</script>
