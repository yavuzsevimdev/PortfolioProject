
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string IsActive(string controller)
    {
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }
}

<aside class="admin-sidebar" id="adminSidebar">

    <!-- Brand Header -->
    <div class="sidebar-header">
        <div class="brand-mark">
            <i class="bi bi-briefcase-fill"></i>
        </div>

        <div class="brand-text">
            <h1>Yavuz Bahadır SEVİM</h1>
            <span>Yönetim Paneli</span>
        </div>
    </div>

    <!-- Menu Links -->
    <div class="sidebar-menu-wrapper">

        <div class="menu-section-label">Menü</div>

        <ul class="sidebar-nav">

            <li>
                <a href="/Admin/Dashboard/Index"
                   class="sidebar-link @IsActive("Dashboard")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li>
                <a href="/Admin/About/AboutList"
                   class="sidebar-link @IsActive("About")">
                    <i class="bi bi-person"></i>
                    <span>Hakkımda</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Skill/SkillList"
                   class="sidebar-link @IsActive("Skill")">
                    <i class="bi bi-stars"></i>
                    <span>Yeteneklerim</span>
                </a>
            </li>

            <li>
                <a href="/Admin/SkillItem/SkillItemList"
                   class="sidebar-link @IsActive("SkillItem")">
                    <i class="bi bi-list-stars"></i>
                    <span>Yetenek Öğeleri</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Experience/ExperienceList"
                   class="sidebar-link @IsActive("Experience")">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span>Deneyimlerim</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Project/ProjectList"
                   class="sidebar-link @IsActive("Project")">
                    <i class="bi bi-code-slash"></i>
                    <span>Projelerim</span>
                </a>
            </li>

            <li>
                <a href="/Admin/ProjectTechnology/ProjectTechnologyList"
                   class="sidebar-link @IsActive("ProjectTechnology")">
                    <i class="bi bi-cpu"></i>
                    <span>Proje Teknolojileri</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Education/EducationList"
                   class="sidebar-link @IsActive("Education")">
                    <i class="bi bi-mortarboard"></i>
                    <span>Eğitim</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Category/Index"
                   class="sidebar-link @IsActive("Category")">
                    <i class="bi bi-tags"></i>
                    <span>Kategoriler</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Contact/ContactList"
                   class="sidebar-link @IsActive("Contact")">
                    <i class="bi bi-envelope"></i>
                    <span>İletişim</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Message/MessageList"
                   class="sidebar-link @IsActive("Message")">

                    <i class="bi bi-inbox"></i>

                    <span>Gelen Mesajlar</span>

                    @if (ViewBag.unreadMessagesCount != null && ViewBag.unreadMessagesCount > 0)
                    {
                        <span class="sidebar-notification-badge">
                            @(ViewBag.unreadMessagesCount > 99 ? "99+" : ViewBag.unreadMessagesCount)
                        </span>
                    }

                </a>
            </li>

            <li>
                <a href="/Admin/SocialMedia/SocialMediaList"
                   class="sidebar-link @IsActive("SocialMedia")">
                    <i class="bi bi-share"></i>
                    <span>Sosyal Medya</span>
                </a>
            </li>

            <li>
                <a href="/Admin/Settings/Index"
                   class="sidebar-link @IsActive("Settings")">
                    <i class="bi bi-gear"></i>
                    <span>Ayarlar</span>
                </a>
            </li>

        </ul>

        <div class="menu-section-label mt-4">Sistem & Bağlantı</div>

        <ul class="sidebar-nav">

            <li>
                <a href="/" target="_blank" class="sidebar-link">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Siteyi Önizle</span>
                </a>
            </li>

            <li>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-file-earmark-code"></i>
                    <span>ASP.NET API</span>
                </a>
            </li>

        </ul>

    </div>

    <!-- Admin User / Logout Footer -->
    <div class="sidebar-footer">

        <div class="admin-user-card">

            <div class="user-avatar-circle">AK</div>

            <div class="user-info">
                <div class="user-name">Admin Kullanıcı</div>
                <div class="user-role">İçerik Yöneticisi</div>
            </div>

            <button class="btn-logout"
                    title="Çıkış Yap"
                    id="btnLogout">
                <i class="bi bi-box-arrow-right"></i>
            </button>

        </div>

    </div>

</aside>
