@model List<MYAcademy_PortfolioProject.Entities.Education>

@{
    ViewData["Title"] = "Eğitim Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="content-header-row">
        <div>
            <h2 class="page-title">Eğitim Listesi</h2>
            <p class="page-subtitle">
                Eğitim bilgilerinizi görüntüleyebilir ve yönetebilirsiniz.
            </p>
        </div>

        <div>
            <a href="/Admin/Education/CreateEducation" class="btn-pastel-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Yeni Eğitim Ekle
            </a>
        </div>
    </div>

    <!-- Education List -->
    <div class="data-table-card">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

            <div>
                <h5 class="fw-semibold mb-1">Eğitim Kayıtları</h5>
                <small class="text-muted">
                    Portfolyonuzda yer alan eğitim bilgileri.
                </small>
            </div>

            <span class="badge rounded-pill bg-light text-dark px-3 py-2">
                Toplam @(Model?.Count ?? 0) Eğitim
            </span>

        </div>

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Eğitim Bilgisi</th>
                        <th>Kurum</th>
                        <th>Etiket</th>
                        <th>Sıralama</th>
                        <th>Durum</th>
                        <th class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="text-muted">
                                        #@item.EducationId
                                    </span>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @item.Degree
                                    </div>

                                    <small class="text-muted">
                                        @item.Department
                                    </small>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Institution))
                                    {
                                        <span>@item.Institution</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Belirtilmedi</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge rounded-pill bg-light text-dark">
                                        @item.BadgeText
                                    </span>
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @item.DisplayOrder
                                    </span>
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">

                                        <a href="/Admin/Education/UpdateEducation/@item.EducationId"
                                           class="btn-table-util"
                                           title="Eğitimi Düzenle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form method="post"
                                              action="/Admin/Education/DeleteEducation"
                                              onsubmit="return confirm('Bu eğitim kaydını silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.EducationId" />

                                            <button type="submit"
                                                    class="btn-table-util"
                                                    title="Eğitimi Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">

                                <i class="bi bi-mortarboard text-muted"
                                   style="font-size: 38px;"></i>

                                <h6 class="mt-3 mb-1">
                                    Henüz eğitim kaydı bulunmuyor
                                </h6>

                                <p class="text-muted small mb-3">
                                    İlk eğitim bilginizi ekleyerek başlayabilirsiniz.
                                </p>

                                <a href="/Admin/Education/CreateEducation"
                                   class="btn-pastel-primary">
                                    <i class="bi bi-plus-lg me-1"></i>
                                    Eğitim Ekle
                                </a>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
