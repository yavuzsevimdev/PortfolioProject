
@model Category

@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    ViewData["Title"] = "Kategori Güncelle";
}

<div class="container-fluid">

    <div class="content-header-row">
        <div>
            <h2 class="page-title">Kategori Güncelle</h2>
            <p class="page-subtitle">
                Mevcut kategori bilgilerini düzenleyebilirsiniz.
            </p>
        </div>

        <a href="/Admin/Category/Index" class="btn-table-util text-decoration-none">
            <i class="bi bi-arrow-left me-2"></i>
            Geri Dön
        </a>
    </div>

    <div class="data-table-card">

        <div class="mb-4">
            <h5 class="fw-semibold mb-1">Kategori Bilgileri</h5>
            <small class="text-muted">
                Kategori bilgilerini güncelleyiniz.
            </small>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="CategoryId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="CategoryName" class="form-label">
                    Kategori Adı
                </label>

                <input asp-for="CategoryName"
                       class="form-control"
                       placeholder="Kategori adını giriniz" />

                <span asp-validation-for="CategoryName"
                      class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">

                <a href="/Admin/Category/Index"
                   class="btn-table-util text-decoration-none">
                    İptal
                </a>

                <button type="submit" class="btn-pastel-primary">
                    <i class="bi bi-check-lg me-2"></i>
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>

    </div>
</div>
