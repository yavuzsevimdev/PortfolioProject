@model List<Category>

@{
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    ViewData["Title"] = "Kategoriler";
}

<div class="container-fluid">

    <div class="content-header-row">
        <div>
            <h2 class="page-title">Kategoriler</h2>
            <p class="page-subtitle">Proje kategorilerini buradan yönetebilirsiniz.</p>
        </div>

        <a href="/Admin/Category/CreateCategory" class="btn-pastel-primary">
            <i class="bi bi-plus-lg me-2"></i>
            Yeni Kategori Ekle
        </a>
    </div>

    @if (TempData["CategoryError"] != null)
    {
        <div class="alert alert-danger mt-3">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["CategoryError"]
        </div>
    }

    <div class="data-table-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="mb-1 fw-semibold">Kategori Listesi</h5>
                <small class="text-muted">Toplam @Model.Count kategori bulunmaktadır.</small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table custom-admin-table align-middle">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Kategori Adı</th>
                        <th>Proje Sayısı</th>
                        <th class="text-center">Düzenle</th>
                        <th class="text-center">Sil</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CategoryId</td>

                                <td>
                                    <span class="fw-semibold">@item.CategoryName</span>
                                </td>

                                <td>
                                    <span class="status-pill status-active">
                                        @(item.Projects?.Count ?? 0) Proje
                                    </span>
                                </td>

                                <td class="text-center">
                                    <a href="/Admin/Category/UpdateCategory/@item.CategoryId"
                                       class="btn-action-icon btn-edit"
                                       title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>

                                <td class="text-center">
                                    <form method="post"
                                          action="/Admin/Category/DeleteCategory/@item.CategoryId"
                                          class="delete-form">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-action-icon btn-delete"
                                                title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                Henüz kategori eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>