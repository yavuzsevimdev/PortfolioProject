
@model Skill

@{
    ViewData["Title"] = "Yeni Yetenek Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <!-- Sayfa Başlığı -->
    <div class="content-header-row mb-4">
        <div>
            <h4 class="page-title">Yeni Yetenek Ekle</h4>
            <p class="page-subtitle">
                Portfolyonuza yeni bir yetenek kategorisi ekleyin.
            </p>
        </div>

        <a href="/Admin/Skill/SkillList" class="btn-table-util text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>
            Listeye Dön
        </a>
    </div>

    <!-- Form Kartı -->
    <div class="data-table-card">

        <form method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <h6 class="fw-semibold mb-3">
                <i class="bi bi-lightbulb me-2"></i>
                Yetenek Bilgileri
            </h6>

            <div class="row g-4">

                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">
                        Yetenek Başlığı
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Örn: Backend Geliştirme" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="IconUrl" class="form-label">
                        İkon Sınıfı
                    </label>

                    <input asp-for="IconUrl"
                           class="form-control"
                           placeholder="Örn: bi bi-database-fill" />

                    <span asp-validation-for="IconUrl"
                          class="text-danger"></span>

                    <small class="text-muted">
                        Bootstrap Icons sınıfını giriniz.
                    </small>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">
                        Açıklama
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Yetenek kategorisi hakkında açıklama giriniz."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <a href="/Admin/Skill/SkillList"
                   class="btn-table-util text-decoration-none">
                    <i class="bi bi-x-lg me-1"></i>
                    İptal
                </a>

                <div class="d-flex gap-2 flex-wrap">

                    <a href="/Admin/SkillItem/CreateSkillItem"
                       class="btn-table-util text-decoration-none">
                        <i class="bi bi-plus-circle me-1"></i>
                        Teknoloji Ekle
                    </a>

                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Kaydet
                    </button>

                </div>
            </div>

        </form>
    </div>
</div>